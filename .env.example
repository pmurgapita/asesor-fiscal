DATABASE_URL="postgresql://usuario:contraseña@localhost:5432/asesor_fiscal?schema=public"
# En producción, si tu proveedor de PostgreSQL soporta TLS (la mayoría),
# añade &sslmode=require al final de la URL de arriba. Ver SEGURIDAD.md.

# Cadena aleatoria de al menos 32 caracteres usada para cifrar la sesión.
# Genérala, por ejemplo, con: openssl rand -hex 32
SESSION_SECRET="cambia-esto-por-una-cadena-aleatoria-larga"

# Solo para scripts/backup.sh y scripts/restore.sh: frase de paso para
# cifrar las copias de seguridad. Ver SEGURIDAD.md.
BACKUP_ENCRYPTION_PASSPHRASE="cambia-esto-por-otra-cadena-aleatoria-larga"
